---
import { site, services, telHref } from '../config';
import Icon from './Icon.astro';
---

<section class="section" id="hizmetler">
  <div class="container">
    <span class="eyebrow">Hizmetlerimiz</span>
    <h2 class="section-title">İhtiyacınız Olan Her An Yanınızdayız</h2>
    <p class="section-lead">
      {site.city}’nin dört bir yanında güvenli ve konforlu ulaşım için tek telefon yeterli.
    </p>

    <div class="grid">
      {
        services.map((s) => (
          <article class="card">
            <span class="icon">
              <Icon name={s.icon} size={22} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a href={telHref} class="card-link" data-conv={`service-${s.icon}`}>
              Hemen ara <Icon name="arrow" size={16} />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .card {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius);
    padding: 28px;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--yellow);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #fff4cc;
    color: var(--black);
  }
  h3 {
    margin-top: 22px;
    font-size: 20px;
    font-weight: 800;
  }
  p {
    margin-top: 10px;
    color: var(--gray-500);
    font-size: 15px;
    flex: 1;
  }
  .card-link {
    margin-top: 20px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 800;
    font-size: 14px;
    color: var(--yellow-dark);
  }
  .card-link:hover {
    color: var(--black);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 620px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
