---
import { site, telHref, waHref } from '../config';
import Icon from './Icon.astro';
---

<section class="banner">
  <div class="container banner-inner">
    <div>
      <span class="eyebrow">Tek dokunuşla ulaşın</span>
      <h2>Taksi mi Lazım?</h2>
      <p>Bizi arayın ya da konumunuzu paylaşın, taksim bulunduğunuz noktaya gelsin.</p>
    </div>
    <div class="banner-actions">
      <a href={telHref} class="btn btn-dark" data-conv="banner-call">
        <Icon name="phone" /> {site.phoneDisplay} — Hemen Ara
      </a>
      <a href={waHref} class="btn btn-wa" target="_blank" rel="noopener" data-conv="banner-whatsapp">
        <Icon name="chat" /> WhatsApp’tan Konum Gönder
      </a>
    </div>
  </div>
</section>

<style>
  .banner {
    background: var(--yellow);
    color: var(--black);
    padding: 48px 0;
  }
  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
  }
  .eyebrow {
    color: var(--black);
    opacity: 0.7;
    margin-bottom: 6px;
  }
  h2 {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 800;
  }
  p {
    margin-top: 8px;
    font-weight: 600;
    max-width: 520px;
  }
  .banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 520px) {
    .banner-actions,
    .banner-actions .btn {
      width: 100%;
    }
    .banner-actions .btn {
      white-space: normal;
      text-align: center;
    }
  }
</style>
