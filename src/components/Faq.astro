---
import { faqs } from '../config';

interface Props {
  items?: { q: string; a: string }[];
}

const { items = faqs } = Astro.props;
---

<section class="section" id="sss">
  <div class="container faq">
    <div class="intro">
      <span class="eyebrow" data-reveal>Sıkça sorulan sorular</span>
      <h2 class="section-title" data-reveal>Aklınıza <em>takılanlar.</em></h2>
    </div>

    <div class="faqs">
      {
        items.map((f, i) => (
          <details open={i === 0} data-reveal>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 64px;
    align-items: start;
  }
  .intro {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .faqs {
    display: grid;
    gap: 12px;
  }
  details {
    background: var(--black-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  details[open] {
    border-color: rgba(255, 196, 0, 0.7);
    background: var(--black-3);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 64px 22px 24px;
    font-weight: 700;
    font-size: 17px;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--black);
    display: grid;
    place-items: center;
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    transition: transform 0.2s;
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    padding: 0 24px 22px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .intro {
      position: static;
    }
    summary {
      font-size: 16px;
      padding: 20px 60px 20px 20px;
    }
    details p {
      padding: 0 20px 20px;
    }
  }
</style>
