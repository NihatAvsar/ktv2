---
import { faqs } from '../config';
---

<section class="section faq-section" id="sss">
  <div class="container faq-wrap">
    <span class="eyebrow">Sıkça sorulan sorular</span>
    <h2 class="section-title">Aklınıza Takılanlar</h2>

    <div class="faqs">
      {
        faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    background: var(--gray-50);
  }
  .faq-wrap {
    max-width: 860px;
    text-align: center;
  }
  .faqs {
    margin-top: 40px;
    display: grid;
    gap: 12px;
    text-align: left;
  }
  details {
    background: var(--white);
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s;
  }
  details[open] {
    border-color: var(--yellow);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 56px 20px 22px;
    font-weight: 700;
    font-size: 16px;
    position: relative;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--yellow);
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    padding: 0 22px 20px;
    color: var(--gray-500);
  }
</style>
