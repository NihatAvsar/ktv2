---
import { site, telHref } from '../config';
import Icon from './Icon.astro';
---

<section class="section dark cta">
  <div class="container">
    <span class="eyebrow">Yola çıkmaya hazır mısınız?</span>
    <h2 class="section-title">{site.city}’de Taksiye mi İhtiyacınız Var?</h2>
    <p class="section-lead">7/24 bize ulaşın, bulunduğunuz konuma dakikalar içinde taksi gönderelim.</p>
    <a href={telHref} class="btn btn-yellow" data-conv="final-call">
      <Icon name="phone" /> Hemen Taksi Çağır — {site.phoneDisplay}
    </a>
  </div>
</section>

<style>
  .cta {
    text-align: center;
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 196, 0, 0.14), transparent 60%),
      var(--black);
  }
  .section-lead {
    margin-left: auto;
    margin-right: auto;
  }
  .btn {
    margin-top: 32px;
    min-height: 58px;
    font-size: 15px;
  }
  @media (max-width: 520px) {
    .btn {
      width: 100%;
      white-space: normal;
    }
  }
</style>
