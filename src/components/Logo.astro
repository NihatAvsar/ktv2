---
import { site } from '../config';

const [first, ...rest] = site.brand.split(' ');
---

<a href="#top" class="logo" aria-label={`${site.brand} ana sayfa`}>
  <span class="logo-box">{site.brandShort}</span>
  <span class="logo-text">{first} <b>{rest.join(' ')}</b></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--white);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 15px;
  }
  .logo-box {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--yellow);
    color: var(--black);
    font-size: 20px;
  }
  .logo-text b {
    color: var(--yellow);
    font-weight: 800;
  }
</style>
