---
import { site, features, telHref } from '../config';
---

<section class="section dark" id="hakkimizda">
  <div class="container why">
    <div>
      <span class="eyebrow">Neden biz?</span>
      <h2 class="section-title">Neden {site.brand}?</h2>
      <p class="section-lead">
        Amacımız sizi yalnızca bir noktadan diğerine götürmek değil; zamanında gelen, temiz, güvenli
        ve güler yüzlü bir yolculuk deneyimi sunmak. {site.city}’yi iyi tanıyan deneyimimizle
        sizi en kısa rotadan ulaştırırız.
      </p>
      <a href={telHref} class="btn btn-yellow" data-conv="why-call">Hemen Arayın</a>
    </div>

    <ol class="features">
      {
        features.map((f, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .why {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: center;
  }
  .btn {
    margin-top: 32px;
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .features li {
    background: var(--black-2);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius);
    padding: 26px;
  }
  .num {
    font-size: 34px;
    font-weight: 800;
    color: var(--yellow);
    line-height: 1;
  }
  h3 {
    margin-top: 16px;
    font-size: 18px;
    font-weight: 800;
  }
  p {
    margin-top: 6px;
    color: #a9a9b1;
    font-size: 14px;
  }

  @media (max-width: 960px) {
    .why {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 460px) {
    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
