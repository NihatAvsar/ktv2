---
import { Picture } from 'astro:assets';
import { site, features, telHref } from '../config';
import Icon from './Icon.astro';
import erciyesYol from '../assets/erciyes-yol.jpg';
---

<section class="section why-section" id="hakkimizda">
  <div class="container why">
    <div class="photo" data-reveal>
      <div class="photo-bg" data-parallax>
        <Picture
          src={erciyesYol}
          formats={['avif', 'webp']}
          widths={[640, 960, 1400]}
          sizes="(max-width: 960px) 100vw, 50vw"
          alt={`Erciyes Dağı'na uzanan ${site.city} yolu`}
          loading="lazy"
        />
      </div>
      <div class="photo-tag">
        <Icon name="pin" size={16} />
        {site.city} · Erciyes
      </div>
    </div>

    <div>
      <span class="eyebrow" data-reveal>Neden biz?</span>
      <h2 class="section-title" data-reveal>Şehri iyi tanır, <em>zamanında</em> geliriz.</h2>
      <p class="section-lead" data-reveal>
        Amacımız sizi yalnızca bir noktadan diğerine götürmek değil; temiz, güvenli ve güler yüzlü bir
        yolculuk sunmak. {site.city}’yi iyi tanıyan deneyimimizle sizi en kısa rotadan ulaştırırız.
      </p>

      <ol class="features">
        {
          features.map((f, i) => (
            <li data-reveal>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <a href={telHref} class="btn btn-yellow" data-conv="why-call" data-reveal>
        <Icon name="phone" /> Hemen Arayın
      </a>
    </div>
  </div>
</section>

<style>
  .why-section {
    background: var(--black-2);
  }
  .why {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }
  .photo {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--black-3);
  }
  .photo-tag {
    position: absolute;
    left: 20px;
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(11, 11, 12, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 13px;
    font-weight: 700;
  }
  .photo-tag :global(svg) {
    color: var(--yellow);
  }
  .features {
    list-style: none;
    margin: 36px 0;
    padding: 0;
  }
  .features li {
    display: flex;
    gap: 22px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .features li:first-child {
    border-top: 1px solid var(--line);
  }
  .num {
    font-size: 15px;
    font-weight: 800;
    color: var(--yellow);
    padding-top: 2px;
  }
  .features h3 {
    font-size: 19px;
    font-weight: 800;
  }
  .features p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 960px) {
    .why {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .photo {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 520px) {
    .btn {
      width: 100%;
    }
  }
</style>
