---
import { site, telHref, waHref } from '../config';
import Icon from './Icon.astro';

const badges = ['7/24 Hizmet', 'Hızlı Ulaşım', 'Güvenli Yolculuk', `${site.city} Geneli`];
---

<section class="hero dark" id="top">
  <div class="container hero-grid">
    <div class="hero-text">
      <span class="eyebrow">{site.city}’de 7/24 taksi hizmeti</span>
      <h1>{site.city} Taksi | 7/24 Hızlı ve Güvenilir Taksi</h1>
      <p class="lead">
        Şehir içi, havalimanı, otogar, hastane ve şehirler arası tüm yolculuklarınızda gece gündüz
        yanınızdayız. Tek telefonla aracınız kapınızda.
      </p>

      <a href={telHref} class="big-phone" data-conv="hero-phone">{site.phoneDisplay}</a>

      <div class="actions">
        <a href={telHref} class="btn btn-yellow" data-conv="hero-call">
          <Icon name="phone" /> Hemen Taksi Çağır
        </a>
        <a href={waHref} class="btn btn-outline" target="_blank" rel="noopener" data-conv="hero-whatsapp">
          <Icon name="chat" /> WhatsApp’tan Taksi Çağır
        </a>
      </div>

      <ul class="badges">
        {badges.map((b) => <li><Icon name="check" size={16} /> {b}</li>)}
      </ul>
    </div>

    <div class="hero-visual">
      <img src="/taxi.svg" alt={`${site.city}’de sarı taksi`} width="600" height="420" fetchpriority="high" />
      <div class="float-card">
        <strong>24/7</strong>
        <span>Her an yanınızdayız</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 96px;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: auto -20% -60% auto;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(255, 196, 0, 0.12), transparent 65%);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
    position: relative;
  }
  h1 {
    font-size: clamp(34px, 5vw, 58px);
    font-weight: 800;
  }
  .lead {
    margin-top: 20px;
    color: #c3c3ca;
    font-size: 17px;
    max-width: 540px;
  }
  .big-phone {
    display: inline-block;
    margin-top: 28px;
    font-size: clamp(32px, 4.4vw, 46px);
    font-weight: 800;
    color: var(--yellow);
    letter-spacing: 0.01em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 24px;
  }
  .badges {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    color: #c3c3ca;
    font-size: 14px;
    font-weight: 600;
  }
  .badges li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .badges :global(svg) {
    color: var(--yellow);
  }
  .hero-visual {
    position: relative;
  }
  .hero-visual img {
    width: 100%;
    height: auto;
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
  }
  .float-card {
    position: absolute;
    right: -14px;
    bottom: -26px;
    background: var(--white);
    color: var(--black);
    padding: 16px 22px;
    border-radius: 16px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .float-card strong {
    font-size: 28px;
    color: var(--yellow-dark);
  }
  .float-card span {
    font-size: 13px;
    font-weight: 600;
    color: var(--gray-500);
  }

  @media (max-width: 960px) {
    .hero {
      padding: 44px 0 72px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .float-card {
      right: 12px;
    }
  }
  @media (max-width: 520px) {
    .actions .btn {
      width: 100%;
    }
  }
</style>
