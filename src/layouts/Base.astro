---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import { getImage } from 'astro:assets';
import { site } from '../config';
import heroMasaustu from '../assets/hero-masaustu.jpg';

interface Props {
  title?: string;
  description?: string;
  path?: string; // "/" veya "/talas-taksi" gibi
  image?: ImageMetadata; // paylaşım görseli (WhatsApp, Facebook önizlemesi)
  faqs?: { q: string; a: string }[];
  breadcrumb?: string; // alt sayfalarda "Ana Sayfa › <bu ad>"
  service?: string; // alt sayfalarda hizmetin adı
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  image = heroMasaustu,
  faqs,
  breadcrumb,
  service,
} = Astro.props;

const home = new URL('/', site.siteUrl).href;
const canonical = new URL(path, site.siteUrl).href;
const ogImage = await getImage({ src: image, width: Math.min(1200, image.width), format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, site.siteUrl).href;
const taxiId = `${home}#taksi`;

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TaxiService',
    '@id': taxiId,
    name: site.brand,
    telephone: site.phoneTel,
    url: home,
    image: new URL((await getImage({ src: heroMasaustu, width: 1200, format: 'jpg' })).src, site.siteUrl).href,
    areaServed: [
      { '@type': 'City', name: site.city },
      ...site.areas.map((name) => ({ '@type': 'AdministrativeArea', name, containedInPlace: site.city })),
    ],
    openingHours: 'Mo-Su 00:00-23:59',
    priceRange: '₺₺',
    ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
  },
];

if (service) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service,
    serviceType: 'Taksi',
    url: canonical,
    description,
    provider: { '@id': taxiId },
    areaServed: { '@type': 'City', name: site.city },
  });
}

if (breadcrumb) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: home },
      { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
    ],
  });
}

if (faqs?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const adsId = site.googleAdsId;
const adsSendTo = adsId && site.googleAdsCallLabel ? `${adsId}/${site.googleAdsCallLabel}` : '';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffc400" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImage.attributes.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Açılış animasyonu başlamadan önce hero yazılarının bir an görünüp kaybolmasını önler.
         Animasyon dosyası 2.5 sn içinde çalışmazsa içerik yine de görünür hâle gelir. -->
    <script is:inline>
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        var r = document.documentElement;
        r.classList.add('anim-pending');
        setTimeout(function () {
          r.classList.remove('anim-pending');
        }, 2500);
      }
    </script>
    <style is:global>
      .anim-pending .hero [data-hero] {
        opacity: 0;
      }
      .anim-pending .hero .big-char {
        transform: translateY(110%);
      }
    </style>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {
      adsId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${adsId}`} />
          <script is:inline define:vars={{ adsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', adsId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <slot />

    <!-- Vercel ziyaretçi istatistikleri (çerezsiz; yalnızca Vercel'de yayındayken veri toplar) -->
    <Analytics />

    <!-- Arama / WhatsApp tıklamalarını Google Ads dönüşümü olarak bildirir (ID yoksa hiçbir şey yapmaz) -->
    <script is:inline define:vars={{ adsSendTo }}>
      document.addEventListener('click', function (e) {
        var link = e.target.closest && e.target.closest('[data-conv]');
        if (!link || !adsSendTo || typeof window.gtag !== 'function') return;
        window.gtag('event', 'conversion', { send_to: adsSendTo, event_label: link.dataset.conv });
      });
    </script>
  </body>
</html>
